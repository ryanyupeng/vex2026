# Deployment source fragment; build_vex.py concatenates fragments in filename order.
class Mechanism:
    """Absolute-position commands monitored even while the chassis moves."""
    def __init__(self, name, motors, hardware, config, max_skew=None):
        self.name, self.motors, self.hw, self.cfg = name, motors, hardware, config
        self.max_skew, self.active, self.target = max_skew, False, None

    def start(self, target_deg, speed_pct, timeout_ms=None):
        if self.active:
            raise ActionFault(Result.MECHANISM_FAULT, self.name + " already has an active move")
        self.target = target_deg
        self.started = self.hw.now()
        self.timeout = timeout_ms if timeout_ms is not None else self.cfg.MECHANISM_TIMEOUT_MS
        if (not finite(target_deg) or not finite(speed_pct) or not 0 < speed_pct <= 100
                or not finite(self.timeout) or self.timeout <= 0):
            raise ValueError("Invalid mechanism command")
        self.settler = Settler(self.cfg.MECHANISM_SETTLE_MS)
        self.skew_settler = Settler(self.cfg.LIFT_SKEW_GRACE_MS)
        self.active = True
        for motor in self.motors:
            motor.set_stopping(HOLD)
            motor.set_timeout(self.timeout, MSEC)
            motor.spin_to_position(target_deg, DEGREES, speed_pct, PERCENT, wait=False)

    def update(self):
        if not self.active:
            return
        now = self.hw.now()
        positions = [m.position(DEGREES) for m in self.motors]
        rates = [m.velocity(RPM) * 6.0 for m in self.motors]
        if not all(finite(v) for v in positions + rates):
            raise ActionFault(Result.SENSOR_FAULT, self.name + " invalid feedback")
        if self.max_skew is not None:
            skew = max(positions) - min(positions)
            if self.skew_settler.update(skew > self.max_skew, now):
                raise ActionFault(Result.MECHANISM_FAULT, self.name + " motors disagree")
        settled = (all(abs(p - self.target) <= self.cfg.MECHANISM_TOL_DEG for p in positions)
                   and all(abs(r) <= self.cfg.MECHANISM_SETTLE_RATE_DEG_S for r in rates))
        if self.settler.update(settled, now):
            self.stop()
        elif now - self.started >= self.timeout:
            raise ActionFault(Result.TIMED_OUT, self.name + " target not reached")

    def stop(self):
        for motor in self.motors:
            motor.stop(HOLD)
        self.active = False



# Development source fragment; build_vex.py concatenates fragments in filename order.

"""Ordered field-coordinate line segments; geometry only, no VEX calls."""


class NavigationPath:
    def __init__(self, start, waypoints):
        self.points = [start]
        for point in waypoints:
            if not isinstance(point, (list, tuple)) or len(point) != 2:
                raise ValueError("Each waypoint must be an (x_mm, y_mm) pair")
            if not all(finite(value) for value in point):
                raise ValueError("Waypoint coordinates must be finite")
            point = (float(point[0]), float(point[1]))
            # Consecutive duplicate points have no segment direction.
            if self.distance(point, self.points[-1]) > 1e-6:
                self.points.append(point)
        if len(self.points) == 1:
            self.points.append(start)  # Already at the target: may still need a turn.
        self.index = 0

    @staticmethod
    def distance(a, b):
        return math.sqrt((a[0] - b[0]) ** 2 + (a[1] - b[1]) ** 2)

    def sample(self, position, lookahead, waypoint_radius):
        # Advance only through the current waypoint's acceptance circle. Never
        # search globally: an intersecting/returning path must retain its order.
        while self.index < len(self.points) - 2:
            if self.distance(position, self.points[self.index + 1]) > waypoint_radius:
                break
            self.index += 1
        a, b = self.points[self.index], self.points[self.index + 1]
        dx, dy = b[0] - a[0], b[1] - a[1]
        length = math.sqrt(dx * dx + dy * dy)
        projection = 0.0 if length < 1e-6 else clamp(
            ((position[0] - a[0]) * dx + (position[1] - a[1]) * dy) / length, 0.0, length)
        fraction = 0.0 if length < 1e-6 else projection / length
        closest = (a[0] + dx * fraction, a[1] + dy * fraction)
        fraction = 0.0 if length < 1e-6 else min(length, projection + lookahead) / length
        target = (a[0] + dx * fraction, a[1] + dy * fraction)
        cross = self.distance(position, closest)
        remaining = self.distance(position, b)
        for i in range(self.index + 1, len(self.points) - 1):
            remaining += self.distance(self.points[i], self.points[i + 1])
        return target, closest, cross, remaining

    def at_last_segment(self):
        return self.index == len(self.points) - 2

"""Dead-reckoning navigation using the existing shared motion coordinator."""


class Navigator:
    def __init__(self, robot):
        self.robot = robot

    def follow_path(self, waypoints, final_heading_deg=None,
                    max_speed_mm_s=None, reverse=False, timeout_ms=None):
        """Follow ordered absolute (x,y) destinations. Start is prepended automatically.

        Uses a moving lookahead point and heading PD, not the X-drive mixer.
        Corner waypoints are accepted within NAV_WAYPOINT_RADIUS_MM; use separate
        go_to_pose calls for exact stops. No obstacle sensing or global localization.
        """
        r, c, p = self.robot, self.robot.cfg, self.robot.tracking
        speed_limit = c.MAX_SPEED_MM_S if max_speed_mm_s is None else max_speed_mm_s
        timeout = c.NAV_TIMEOUT_MS if timeout_ms is None else timeout_ms
        try:
            if not r.ready or p.last_time is None:
                return r.failure(Result.NOT_READY, "Begin autonomous before navigation")
            if (not isinstance(waypoints, (list, tuple)) or not waypoints
                    or not finite(speed_limit) or speed_limit <= 0
                    or not finite(timeout) or timeout <= 0
                    or not isinstance(reverse, bool)
                    or (final_heading_deg is not None and not finite(final_heading_deg))):
                raise ValueError("Invalid path, heading, speed, reverse flag or timeout")
            path = NavigationPath((p.x, p.y), waypoints)
            speed_limit = min(speed_limit, c.MAX_SPEED_MM_S)
            direction = -1.0 if reverse else 1.0
            pid = PID(c.HEADING_KP, kd=c.HEADING_KD, tau=c.RATE_FILTER_TAU_S)
            settled = Settler(c.SETTLE_MS)
            started = r.hw.now()
            speed = turn = 0.0
            recovery_since, recovery_count = None, 0
            previous_index = -1
            best_remaining = best_angle = float("inf")
            progress_since = started
            previous_mode = None
            stall_since = None
            stall_position = (p.x, p.y)
            stall_heading = p.heading
            end_heading = final_heading_deg

            while True:
                dt = r.tick()  # Services X/Y tracking, all mechanisms, cancellation.
                now = r.hw.now()
                if now - started >= timeout:
                    return r.failure(Result.TIMED_OUT, "Navigation action deadline")
                if dt <= 0:
                    r.hw.pause()
                    continue
                position = (p.x, p.y)
                target, closest, cross, remaining = path.sample(
                    position, c.NAV_LOOKAHEAD_MM, c.NAV_WAYPOINT_RADIUS_MM)
                distance = path.distance(position, path.points[-1])
                if cross > c.NAV_MAX_CROSS_MM:
                    return r.failure(Result.PATH_ERROR, "Too far from active path segment")

                if cross > c.NAV_RECOVERY_CROSS_MM and recovery_since is None:
                    recovery_since = now
                    recovery_count += 1
                    if recovery_count > c.NAV_RECOVERY_ATTEMPTS:
                        return r.failure(Result.PATH_ERROR, "Path recovery attempts exhausted")
                if recovery_since is not None:
                    if cross <= c.NAV_RECOVERY_CROSS_MM * 0.5:
                        recovery_since = None
                    elif now - recovery_since >= c.NAV_RECOVERY_TIMEOUT_MS:
                        return r.failure(Result.PATH_ERROR, "Path recovery timed out")
                    else:
                        target = closest  # Rejoin at low speed; do not skip ahead.

                position_ok = path.at_last_segment() and distance <= c.NAV_POSITION_TOL_MM
                if position_ok:
                    # First stop translation, then finish the requested heading.
                    if end_heading is None:
                        end_heading = p.heading
                    desired_heading = end_heading
                    desired_speed = 0.0
                    mode = "finish"
                else:
                    if final_heading_deg is None:
                        end_heading = None
                    dx, dy = target[0] - p.x, target[1] - p.y
                    desired_heading = math.degrees(math.atan2(dx, dy)) + (180.0 if reverse else 0.0)
                    bearing_error = angle_error(desired_heading, p.heading)
                    # Slow for corners and endpoints; don't drive away while facing
                    # the wrong direction. Rotation can reorient after an overshoot.
                    available = min(speed_limit, c.NAV_POSITION_KP * remaining,
                                    math.sqrt(2.0 * c.DECEL_MM_S2 * remaining))
                    if recovery_since is not None:
                        available = min(available, c.NAV_RECOVERY_SPEED_MM_S)
                    if abs(bearing_error) >= c.NAV_ALIGN_DEG:
                        desired_speed = 0.0
                        mode = "align"
                    else:
                        desired_speed = direction * available * max(0.0, math.cos(math.radians(bearing_error)))
                        mode = "travel"

                error = angle_error(desired_heading, p.heading)
                desired_turn = pid.update(error, p.heading, dt, c.MAX_TURN_WHEEL_MM_S)
                if position_ok and p.speed > c.SETTLE_SPEED_MM_S:
                    desired_turn = 0.0
                rate = c.ACCEL_MM_S2 if abs(desired_speed) > abs(speed) else c.DECEL_MM_S2
                speed = approach(speed, desired_speed, rate * dt)
                turn = approach(turn, desired_turn, c.TURN_SLEW_MM_S2 * dt)
                done = (position_ok and abs(error) <= c.HEADING_TOL_DEG
                        and p.speed <= c.SETTLE_SPEED_MM_S
                        and abs(p.angular_rate) <= c.SETTLE_RATE_DEG_S)
                if settled.update(done, now):
                    r.log("nav arrived", distance, cross)
                    return Result(Result.ARRIVED)

                # A monotonic best-distance/angle watchdog catches creep and loops.
                # Reset only at a waypoint or a change between travel and turning.
                if path.index != previous_index or mode != previous_mode:
                    progress_since = now
                    best_remaining, best_angle = remaining, abs(error)
                    previous_index, previous_mode = path.index, mode
                improved = ((mode == "travel" and remaining < best_remaining - c.STALL_MIN_PROGRESS_MM)
                            or (mode != "travel" and abs(error) < best_angle - c.STALL_MIN_ROTATION_DEG))
                if improved:
                    progress_since = now
                    best_remaining, best_angle = min(best_remaining, remaining), min(best_angle, abs(error))
                if not done and now - progress_since >= c.NAV_NO_PROGRESS_MS:
                    return r.failure(Result.STALLED, "No useful navigation progress")

                # Faster detection of a commanded move/turn that produces no motion.
                translating = abs(speed) >= c.STALL_COMMAND_MM_S
                rotating = abs(turn) >= c.STALL_COMMAND_MM_S
                moved = path.distance(position, stall_position) >= c.STALL_MIN_PROGRESS_MM
                turned = abs(p.heading - stall_heading) >= c.STALL_MIN_ROTATION_DEG
                if translating or rotating:
                    if stall_since is None or (moved if translating else turned):
                        stall_since, stall_position, stall_heading = now, position, p.heading
                    elif now - stall_since >= c.STALL_WINDOW_MS:
                        return r.failure(Result.STALLED, "No motion during navigation")
                else:
                    stall_since = None
                r.drive.command(speed + turn, speed - turn)
                label = "rejoin%d %s" % (recovery_count, mode) if recovery_since is not None else mode
                r.log("nav %s segment=%d" % (label, path.index), distance, cross)
                r.hw.pause()
        except ActionFault as fault:
            return r.failure(fault.result.status, fault.result.detail)
        except Exception:
            r.stop_all()
            raise
        finally:
            r.drive.stop()

# Deployment source fragment; build_vex.py concatenates fragments in filename order.
class Robot:
    def __init__(self, hardware, spec=RobotSpec, config=ControlConfig):
        self.hw, self.spec, self.cfg = hardware, spec, config
        self.drive = Drive(hardware, spec, config)
        self.tracking = Tracking(hardware, spec, config)
        self.navigator = Navigator(self)
        self.lift = Mechanism("lift", hardware.lift, hardware, config, config.LIFT_MAX_SKEW_DEG)
        self.left_wing = Mechanism("left wing", (hardware.wings[0],), hardware, config)
        self.right_wing = Mechanism("right wing", (hardware.wings[1],), hardware, config)
        self.mechanisms = (self.lift, self.left_wing, self.right_wing)
        self.ready = False
        self.active = lambda: False
        self.route_deadline = None
        self.last_log = -config.LOG_INTERVAL_MS

    def stop_all(self):
        self.drive.stop()
        for mechanism in self.mechanisms:
            mechanism.stop()

    def failure(self, status, detail):
        # Failure of any action cancels pending mechanism work as well as driving.
        self.stop_all()
        return Result(status, detail)

    def prepare(self):
        self.ready = False
        self.stop_all()
        errors = self.spec.validate()
        if errors:
            for error in errors:
                print("CONFIG: " + error)
            self.hw.show("Fill RobotSpec; autonomous not ready")
            return Result(Result.NOT_READY, "; ".join(errors))
        try:
            self.hw.check_devices()
            self.hw.show("Keep robot still: calibrating")
            self.hw.imu.calibrate()
            started = self.hw.now()
            while self.hw.imu.is_calibrating():
                if self.hw.now() - started >= self.cfg.CALIBRATION_TIMEOUT_MS:
                    raise ActionFault(Result.TIMED_OUT, "IMU calibration")
                self.hw.pause()
            for motor, position in zip(self.hw.lift, self.spec.LIFT_REFERENCE_DEG):
                motor.set_position(position, DEGREES)
            for motor, position in zip(self.hw.wings, self.spec.WING_REFERENCE_DEG):
                motor.set_position(position, DEGREES)
            self.hw.check_devices()
            self.ready = True
            self.hw.show("Ready: place at configured start pose")
            return Result(Result.ARRIVED)
        except ActionFault as fault:
            self.hw.show(fault.result.status + ": " + fault.result.detail)
            return fault.result

    def begin_autonomous(self, active):
        self.active = active
        self.stop_all()
        if not self.ready:
            raise ActionFault(Result.NOT_READY, "Calibration/configuration incomplete")
        if not active():
            raise ActionFault(Result.CANCELLED, "Autonomous is not enabled")
        self.hw.check_devices()
        self.tracking.reset(self.spec.START_X_MM, self.spec.START_Y_MM,
                            self.spec.START_HEADING_DEG)
        self.route_deadline = self.hw.now() + self.cfg.ROUTE_TIMEOUT_MS

    def tick(self):
        if not self.active():
            raise ActionFault(Result.CANCELLED, "Competition disabled or changed mode")
        if self.route_deadline is not None and self.hw.now() >= self.route_deadline:
            raise ActionFault(Result.TIMED_OUT, "Autonomous time budget exhausted")
        self.hw.check_devices()
        dt = self.tracking.update()
        for mechanism in self.mechanisms:
            mechanism.update()
        return dt

    def log(self, name, distance_error=0.0, cross_error=0.0):
        now = self.hw.now()
        if now - self.last_log >= self.cfg.LOG_INTERVAL_MS:
            self.last_log = now
            p = self.tracking
            print("%s t=%d x=%.1f y=%.1f h=%.1f dist_err=%.1f cross=%.1f speed=%.1f" %
                  (name, now, p.x, p.y, p.heading, distance_error, cross_error, p.speed))

    def drive_distance(self, distance_mm, heading_deg, max_speed_mm_s, timeout_ms=None):
        """Signed straight segment. X feedback steers out moderate lateral drift.

        Large lateral displacement near the endpoint may not be recoverable without
        another maneuver. Report failure instead of falsely declaring arrival.
        """
        timeout = self.cfg.ACTION_TIMEOUT_MS if timeout_ms is None else timeout_ms
        started = self.hw.now()
        p, c = self.tracking, self.cfg
        start_x, start_y = p.x, p.y
        heading = math.radians(heading_deg)
        distance_pid = PID(c.DISTANCE_KP, kd=c.DISTANCE_KD, tau=c.RATE_FILTER_TAU_S)
        heading_pid = PID(c.HEADING_KP, kd=c.HEADING_KD, tau=c.RATE_FILTER_TAU_S)
        settled = Settler(c.SETTLE_MS)
        speed = turn = 0.0
        stall_since, stall_progress = None, 0.0
        try:
            if (not finite(distance_mm) or not finite(heading_deg)
                    or not finite(max_speed_mm_s) or max_speed_mm_s <= 0
                    or not finite(timeout) or timeout <= 0):
                raise ValueError("Invalid drive parameters")
            limit = min(max_speed_mm_s, c.MAX_SPEED_MM_S)
            while True:
                dt = self.tick()
                now = self.hw.now()
                if now - started >= timeout:
                    return self.failure(Result.TIMED_OUT, "drive distance")
                if dt <= 0:
                    self.hw.pause()
                    continue
                dx, dy = p.x - start_x, p.y - start_y
                progress = dx * math.sin(heading) + dy * math.cos(heading)
                cross = dx * math.cos(heading) - dy * math.sin(heading)
                error = distance_mm - progress
                if abs(cross) > c.MAX_CROSS_TRACK_MM:
                    return self.failure(Result.PATH_ERROR, "Lateral displacement exceeds recovery limit")
                target_speed = distance_pid.update(error, progress, dt, limit)
                braking_limit = math.sqrt(2.0 * c.DECEL_MM_S2 * abs(error))
                target_speed = clamp(target_speed, -braking_limit, braking_limit)
                position_ok = abs(error) <= c.DISTANCE_TOL_MM and abs(cross) <= c.CROSS_TRACK_TOL_MM
                if position_ok:
                    target_speed = 0.0
                travel_sign = 1 if target_speed >= 0 else -1
                correction = clamp(math.degrees(math.atan2(-cross * travel_sign,
                                   c.CROSS_TRACK_LOOKAHEAD_MM)),
                                   -c.MAX_STEERING_OFFSET_DEG, c.MAX_STEERING_OFFSET_DEG)
                desired_heading = heading_deg if position_ok else heading_deg + correction
                target_turn = heading_pid.update(angle_error(desired_heading, p.heading),
                                                p.heading, dt, c.MAX_TURN_WHEEL_MM_S)
                if speed * target_speed < 0:  # Brake before reversing translation.
                    speed = approach(speed, 0.0, c.DECEL_MM_S2 * dt)
                else:
                    rate = c.ACCEL_MM_S2 if abs(target_speed) > abs(speed) else c.DECEL_MM_S2
                    speed = approach(speed, target_speed, rate * dt)
                turn = approach(turn, target_turn, c.TURN_SLEW_MM_S2 * dt)
                done = (position_ok and abs(angle_error(heading_deg, p.heading)) <= c.HEADING_TOL_DEG
                        and p.speed <= c.SETTLE_SPEED_MM_S
                        and abs(p.angular_rate) <= c.SETTLE_RATE_DEG_S)
                if settled.update(done, now):
                    return Result(Result.ARRIVED)
                if abs(speed) >= c.STALL_COMMAND_MM_S:
                    if stall_since is None or abs(progress - stall_progress) >= c.STALL_MIN_PROGRESS_MM:
                        stall_since, stall_progress = now, progress
                    elif now - stall_since >= c.STALL_WINDOW_MS:
                        return self.failure(Result.STALLED, "No tracking-wheel progress during drive")
                else:
                    stall_since = None
                self.drive.command(speed + turn, speed - turn)
                self.log("drive", error, cross)
                self.hw.pause()
        except ActionFault as fault:
            return self.failure(fault.result.status, fault.result.detail)
        finally:
            self.drive.stop()

    def turn_to_heading(self, target_deg, timeout_ms=None):
        c, p = self.cfg, self.tracking
        timeout = c.ACTION_TIMEOUT_MS if timeout_ms is None else timeout_ms
        started = self.hw.now()
        pid = PID(c.TURN_KP, kd=c.TURN_KD, tau=c.RATE_FILTER_TAU_S)
        settled = Settler(c.SETTLE_MS)
        command = 0.0
        stall_since, stall_heading = None, p.heading
        try:
            if not finite(target_deg) or not finite(timeout) or timeout <= 0:
                raise ValueError("Invalid turn parameters")
            while True:
                dt = self.tick()
                now = self.hw.now()
                if now - started >= timeout:
                    return self.failure(Result.TIMED_OUT, "turn")
                if dt <= 0:
                    self.hw.pause()
                    continue
                error = angle_error(target_deg, p.heading)
                desired = pid.update(error, p.heading, dt, c.MAX_TURN_WHEEL_MM_S)
                command = approach(command, desired, c.TURN_SLEW_MM_S2 * dt)
                if settled.update(abs(error) <= c.HEADING_TOL_DEG
                                  and abs(p.angular_rate) <= c.SETTLE_RATE_DEG_S
                                  and p.speed <= c.SETTLE_SPEED_MM_S, now):
                    return Result(Result.ARRIVED)
                if abs(command) >= c.STALL_COMMAND_MM_S:
                    if stall_since is None or abs(p.heading - stall_heading) >= c.STALL_MIN_ROTATION_DEG:
                        stall_since, stall_heading = now, p.heading
                    elif now - stall_since >= c.STALL_WINDOW_MS:
                        return self.failure(Result.STALLED, "No IMU rotation during turn")
                else:
                    stall_since = None
                self.drive.command(command, -command)
                self.log("turn")
                self.hw.pause()
        except ActionFault as fault:
            return self.failure(fault.result.status, fault.result.detail)
        finally:
            self.drive.stop()

    def wait_for(self, mechanism=None, duration_ms=0):
        """Keep tracking, cancellation and mechanism deadlines alive while waiting."""
        started = self.hw.now()
        try:
            while True:
                self.tick()
                if ((mechanism is None or not mechanism.active)
                        and self.hw.now() - started >= duration_ms):
                    return Result(Result.ARRIVED)
                self.hw.pause()
        except ActionFault as fault:
            return self.failure(fault.result.status, fault.result.detail)

    def require(self, result, step):
        print("%s: %s %s" % (step, result.status, result.detail))
        if not result.ok():
            raise ActionFault(result.status, step + ": " + result.detail)

    def set_claw(self, closed):
        self.tick()
        self.hw.claw.set(self.spec.CLAW_CLOSED if closed else not self.spec.CLAW_CLOSED)

    def go_to_pose(self, x_mm, y_mm, heading_deg=None, max_speed_mm_s=None,
                   reverse=False, timeout_ms=None):
        """Reach an absolute field position, then settle at the final heading."""
        return self.follow_path([(x_mm, y_mm)], heading_deg, max_speed_mm_s,
                                reverse, timeout_ms)

    def follow_path(self, waypoints, final_heading_deg=None, max_speed_mm_s=None,
                    reverse=False, timeout_ms=None):
        """Ordered absolute destinations; current pose is automatically the start."""
        return self.navigator.follow_path(waypoints, final_heading_deg,
                                          max_speed_mm_s, reverse, timeout_ms)



# Development source fragment; build_vex.py concatenates fragments in filename order.

# Deployment source fragment; build_vex.py concatenates fragments in filename order.
def run_route(robot):
    """Sample task sequence, now with precise turns and checked outcomes.

    The old 500 ms drive is distance travel here, NOT an inferred contact/push.
    Survey the distances and validate the now fully completed 90-degree turn.
    """
    # Tune the sample route here as the field route changes. These values are
    # deliberately local to the route instead of hidden behind a config class.
    legacy_sensor_turns_per_unit = 0.31
    first_leg_units = 4.0
    second_leg_units = 5.0
    final_approach_units = 5.0
    retreat_units = 2.0
    last_leg_units = 3.0
    first_turn_deg = 90.0
    last_turn_deg = 50.0
    lift_carry_deg = 300.0
    lift_release_deg = 100.0
    lift_clear_deg = 150.0
    right_wing_deploy_deg = 300.0
    mechanism_speed_pct = 80

    c, s = robot.cfg, robot.spec
    unit_mm = (legacy_sensor_turns_per_unit * math.pi * s.TRACK_Y_DIAMETER_MM
               / s.TRACK_Y_SENSOR_TURNS_PER_WHEEL_TURN)
    robot.set_claw(True)
    robot.lift.start(lift_carry_deg, mechanism_speed_pct)
    robot.right_wing.start(right_wing_deploy_deg, mechanism_speed_pct)
    robot.require(robot.wait_for(robot.right_wing), "deploy right wing")
    robot.require(robot.drive_distance(first_leg_units * unit_mm,
                  s.START_HEADING_DEG, 0.7 * c.MAX_SPEED_MM_S), "first leg")
    robot.require(robot.turn_to_heading(first_turn_deg), "first turn")
    robot.require(robot.drive_distance(second_leg_units * unit_mm,
                  first_turn_deg, c.MAX_SPEED_MM_S), "second leg")
    robot.require(robot.drive_distance(final_approach_units * unit_mm,
                  first_turn_deg, 0.5 * c.MAX_SPEED_MM_S), "final approach")
    robot.require(robot.wait_for(robot.lift), "finish carry lift")
    robot.lift.start(lift_release_deg, mechanism_speed_pct)
    robot.require(robot.wait_for(robot.lift), "lower before release")
    robot.set_claw(False)
    robot.require(robot.wait_for(duration_ms=150), "claw release dwell")
    robot.lift.start(lift_clear_deg, mechanism_speed_pct)
    robot.require(robot.wait_for(robot.lift), "clear released object")
    robot.lift.start(lift_carry_deg, mechanism_speed_pct)
    robot.require(robot.drive_distance(-retreat_units * unit_mm,
                  first_turn_deg, 0.7 * c.MAX_SPEED_MM_S), "retreat")
    robot.require(robot.turn_to_heading(last_turn_deg), "last turn")
    robot.require(robot.drive_distance(last_leg_units * unit_mm,
                  last_turn_deg, 0.3 * c.MAX_SPEED_MM_S), "last leg")
    robot.require(robot.wait_for(robot.lift), "finish lift")

# Development source fragment; build_vex.py concatenates fragments in filename order.

"""Navigation sample; points are absolute field coordinates."""


def run_navigation_example(robot):
    # Tune the navigation sample here as the test field changes.
    points_mm = ((0.0, 400.0), (300.0, 600.0))
    final_heading_deg = 90.0
    speed_mm_s = 250.0
    timeout_ms = 10000

    robot.require(robot.follow_path(
        points_mm,
        final_heading_deg=final_heading_deg,
        max_speed_mm_s=speed_mm_s,
        timeout_ms=timeout_ms,
    ), "navigation example")

# Deployment source fragment; build_vex.py concatenates fragments in filename order.
AUTONOMOUS_ROUTE = "sample"  # "sample" or "navigation_example"


def main():
    hw = Hardware(RobotSpec)
    robot = Robot(hw)
    competition = None

    def autonomous():
        try:
            robot.begin_autonomous(lambda: competition.is_enabled() and competition.is_autonomous())
            if AUTONOMOUS_ROUTE == "sample":
                run_route(robot)
            elif AUTONOMOUS_ROUTE == "navigation_example":
                run_navigation_example(robot)
            else:
                raise ValueError("Unknown AUTONOMOUS_ROUTE")
            hw.show("Autonomous ARRIVED")
        except ActionFault as fault:
            hw.show(fault.result.status + ": " + fault.result.detail)
        except Exception as error:
            hw.show("Autonomous error: " + str(error))
        finally:
            robot.stop_all()

    def user_control():
        # No persistent claw thread: only the active mode owns actuator commands.
        if not robot.ready:
            hw.show("NOT_READY: check RobotSpec/calibration")
            return
        robot.stop_all()
        previous_claw_button = False
        try:
            while competition.is_enabled() and competition.is_driver_control():
                a3 = hw.controller.axis3.position()
                a1 = hw.controller.axis1.position()
                turn = a1 * abs(a1) / 100.0
                if abs(a3) + abs(turn) <= 3:
                    robot.drive.stop()
                else:
                    scale = robot.cfg.MAX_SPEED_MM_S / 100.0
                    robot.drive.command((a3 + turn) * scale, (a3 - turn) * scale)
                pressed = hw.controller.buttonR1.pressing()
                if pressed and not previous_claw_button:
                    hw.claw.set(not hw.claw.value())
                previous_claw_button = pressed
                for motor in hw.lift:
                    if hw.controller.buttonL1.pressing():
                        motor.spin(FORWARD, 100, PERCENT)
                    elif hw.controller.buttonL2.pressing():
                        motor.spin(REVERSE, 100, PERCENT)
                    else:
                        motor.stop(HOLD)
                for motor in hw.wings:
                    if hw.controller.buttonR2.pressing():
                        motor.spin(FORWARD, 100, PERCENT)
                    else:
                        motor.stop(HOLD)
                hw.pause()
        finally:
            robot.stop_all()

    # Calibration completes before competition callbacks are installed.
    wait(200, MSEC)  # Allow smart-port devices to initialize before presence checks.
    robot.prepare()
    competition = Competition(user_control, autonomous)
    while True:
        wait(100, MSEC)


if __name__ == "__main__":
    main()
